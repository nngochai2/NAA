# Azure DevOps Server (on-premises) connection
# Copy this file to .env and fill in your values. Never commit .env to source control.
# Full base URL including collection name, no trailing slash
# Example: [http://192.168.1.50/DefaultCollection](http://192.168.1.50/DefaultCollection)

ADO_BASE_URL=

# The project name exactly as it appears in ADO (case-sensitive)
ADO_PROJECT=

# Shared team credentials
ADO_USERNAME=
ADO_PASSWORD=

# API version — use 5.0 for ADO Server 2019, 4.1 for older installs
ADO_API_VERSION=

# MCP server binding (leave as-is for team VM deployment)
MCP_HOST=
MCP_PORT=
NO_PROXY=