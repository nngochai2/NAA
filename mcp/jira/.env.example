# Jira Data Center instance
JIRA_URL=https://insight.fsoft.com.vn/jiradc
JIRA_PROJECT_KEY=
JIRA_SSL_VERIFY=true

# No JIRA_PAT here — each team member supplies their own Jira PAT via their own
# mcp.json's Authorization: Bearer <PAT> header. See the Jira MCP section of the
# root README for how to configure this per member.

MCP_HOST=0.0.0.0
MCP_PORT=8005
