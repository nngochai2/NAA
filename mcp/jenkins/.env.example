# Jenkins controller (include any context path, e.g. https://ci.example.com/jenkins)
JENKINS_URL=
JENKINS_SSL_VERIFY=true
JENKINS_TIMEOUT=30

# Optional tool filters (comma-separated tool names). If JENKINS_ALLOW_TOOLS is set it wins
# and JENKINS_BLOCK_TOOLS is ignored.
# JENKINS_ALLOW_TOOLS=
# JENKINS_BLOCK_TOOLS=jenkins_delete_job,jenkins_delete_build,jenkins_safe_restart

# No Jenkins credential here — each team member supplies their own via their own
# mcp.json Authorization header: "Basic <base64(user:api_token)>" or "Bearer <token>".
# See the Jenkins MCP section of the root README.

MCP_HOST=0.0.0.0
MCP_PORT=8006
