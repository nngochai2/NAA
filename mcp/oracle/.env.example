# =============================================================
# Oracle MCP Server — Environment Configuration
# Copy to mcp/oracle/.env (never commit .env)
# =============================================================

# -------------------- Oracle Connection ----------------------
ORACLE_HOST=localhost
ORACLE_PORT=1521

# Use SERVICE_NAME (preferred for RAC / pluggable DBs), e.g. INVOICING
ORACLE_SERVICE=

# Use SID only if SERVICE_NAME is unavailable, e.g. XE
ORACLE_SID=

# Read-only MCP user — see sql/db_setup.sql
ORACLE_USER=
ORACLE_PASSWORD=

# ------------ Thick Mode (required for Oracle 11g) ------------
# Path to Oracle Instant Client directory.
# Leave blank to auto-discover from PATH / LD_LIBRARY_PATH.
#
# Linux example:  /usr/lib/oracle/21/client64/lib
# Windows example: C:\oracle\instantclient_21_13
ORACLE_CLIENT_LIB_DIR=

# ------------------- Schema Configuration ---------------------
# Schema to use when no schema argument is supplied to a tool.
# Defaults to ORACLE_USER if left blank.
ORACLE_DEFAULT_SCHEMA=

# Comma-separated schema allowlist, e.g. INVOICING,INVOICING_REF
# Leave blank to expose all schemas visible to ORACLE_USER.
ALLOWED_SCHEMAS=

# ---------------------- Query Safety --------------------------
# Hard ceiling on rows returned by execute_query.
# Callers can request fewer, never more.
MAX_ROWS=200

# ---------------------- MCP Transport -------------------------
# sse   — network server, started by the webapp (default)
# stdio — local process launched directly by an editor (e.g. VS Code)
MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
MCP_PORT=8003

# ------------------------ Logging -----------------------------
LOG_LEVEL=INFO
